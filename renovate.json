{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "baseBranches": [
    "develop"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "npm のマイナー・パッチ更新を1つのPRにまとめる",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major dependencies"
    },
    {
      "description": "GitHub Actions の更新を1つのPRにまとめる",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Prisma CLI と Prisma Client のバージョンを常に揃えて更新する",
      "matchPackageNames": [
        "prisma",
        "@prisma/client"
      ],
      "groupName": "prisma"
    },
    {
      "description": "Next.js と eslint-config-next のバージョンを常に揃えて更新する",
      "matchPackageNames": [
        "next",
        "eslint-config-next"
      ],
      "groupName": "nextjs"
    },
    {
      "description": "React 本体と型定義パッケージをまとめて更新する",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Tailwind CSS 関連パッケージをまとめて更新する",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/postcss"
      ],
      "groupName": "tailwindcss"
    }
  ]
}
